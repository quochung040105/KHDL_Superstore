      <aliases enabled='yes' />
      <column caption='Sales (kỳ)' datatype='real' name='[Calculation_3607415050133505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; THEN SUM([Sales]) ELSE SUM(IF STR(YEAR([Order Date])) = [Parameters].[Parameter 3607415047954432] THEN [Sales] END) END' />
      </column>
      <column caption='Profit (kỳ)' datatype='real' name='[Calculation_3607415050858498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; THEN SUM([Profit]) ELSE SUM(IF STR(YEAR([Order Date])) = [Parameters].[Parameter 3607415047954432] THEN [Profit] END) END' />
      </column>
      <column caption='Orders (kỳ)' datatype='integer' name='[Calculation_3607415050956803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; THEN COUNTD([Order ID]) ELSE COUNTD(IF STR(YEAR([Order Date])) = [Parameters].[Parameter 3607415047954432] THEN [Order ID] END) END' />
      </column>
      <column caption='Profit Margin %' datatype='real' default-format='p0.0%' name='[Calculation_3607415051145220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3607415050858498] / [Calculation_3607415050133505]' />
      </column>
      <column caption='Customers (kỳ)' datatype='integer' name='[Calculation_3607415051231237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; THEN COUNTD([Customer ID]) ELSE COUNTD(IF STR(YEAR([Order Date])) = [Parameters].[Parameter 3607415047954432] THEN [Customer ID] END) END' />
      </column>
      <column caption='Returned Orders (kỳ)' datatype='integer' name='[Calculation_3607415051309062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_returned] = 1 AND ([Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; OR STR(YEAR([Order Date])) = [Parameters].[Parameter 3607415047954432]) THEN [Order ID] END)' />
      </column>
      <column caption='Return Rate %' datatype='real' default-format='p0.0%' name='[Calculation_3607415051395079]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3607415051309062] / [Calculation_3607415050956803]' />
      </column>
      <column caption='Avg Order Value' datatype='real' name='[Calculation_3607415051464712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3607415050133505] / [Calculation_3607415050956803]' />
      </column>
      <column caption='Sales kỳ trước' datatype='real' name='[Calculation_3607415051550729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] &lt;&gt; &quot;Tất cả&quot; THEN SUM(IF STR(YEAR([Order Date])) = STR(INT([Parameters].[Parameter 3607415047954432]) - 1) THEN [Sales] END) END' />
      </column>
      <column caption='Sales YoY %' datatype='real' default-format='p0.0%' name='[Calculation_3607415051624458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3607415050133505] - [Calculation_3607415051550729]) / [Calculation_3607415051550729]' />
      </column>
      <column caption='Profit kỳ trước' datatype='real' name='[Calculation_3607415051677707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] &lt;&gt; &quot;Tất cả&quot; THEN SUM(IF STR(YEAR([Order Date])) = STR(INT([Parameters].[Parameter 3607415047954432]) - 1) THEN [Profit] END) END' />
      </column>
      <column caption='Profit YoY %' datatype='real' default-format='p0.0%' name='[Calculation_3607415051710476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3607415050858498] - [Calculation_3607415051677707]) / [Calculation_3607415051677707]' />
      </column>
      <column caption='Orders kỳ trước' datatype='integer' name='[Calculation_3607415051804685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] &lt;&gt; &quot;Tất cả&quot; THEN COUNTD(IF STR(YEAR([Order Date])) = STR(INT([Parameters].[Parameter 3607415047954432]) - 1) THEN [Order ID] END) END' />
      </column>
      <column caption='Orders YoY %' datatype='real' default-format='p0.0%' name='[Calculation_3607415051948046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3607415050956803] - [Calculation_3607415051804685]) / [Calculation_3607415051804685]' />
      </column>
      <column caption='Loss Rows %' datatype='real' default-format='p0.0%' name='[Calculation_3607415051976719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Profit] &lt; 0 THEN 1 ELSE 0 END) / COUNT([Profit])' />
      </column>
      <column caption='Avg Discount' datatype='real' name='[Calculation_3607415052025872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount])' />
      </column>
      <column caption='Discount Level Sort' datatype='integer' name='[Calculation_3607415052124177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Discount_Level] WHEN &quot;Không&quot; THEN 0 WHEN &quot;Thấp&quot; THEN 1 WHEN &quot;Cao&quot; THEN 2 END' />
      </column>
      <column caption='State Profit' datatype='real' name='[Calculation_3607415052283922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [State] : SUM([Profit])}' />
      </column>
      <column caption='SubCat Profit' datatype='real' name='[Calculation_3607415052357651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Sub-Category] : SUM([Profit])}' />
      </column>
      <column caption='Title Sales' datatype='string' name='[Calculation_3607415052419092]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Sales &quot; + IF [Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; THEN &quot;2016–2019&quot; ELSE [Parameters].[Parameter 3607415047954432] END + &quot;: &quot; + STR(INT(ROUND([Calculation_3607415050133505], 0))) + &quot; USD&quot; + IF ISNULL([Calculation_3607415051624458]) THEN &quot;, chưa có năm trước&quot; ELSE &quot;, &quot; + STR(ROUND([Calculation_3607415051624458] * 100, 1)) + &quot;% so với năm trước&quot; END' />
      </column>
      <column caption='Title Loss States' datatype='string' name='[Calculation_3607415052496917]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR({FIXED : COUNTD(IF [Calculation_3607415052283922] &lt; 0 THEN [State] END)}) + &quot; bang bị lỗ&quot;' />
      </column>
      <column caption='Title Loss SubCat' datatype='string' name='[Calculation_3607415052554262]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR({FIXED : COUNTD(IF [Calculation_3607415052357651] &lt; 0 THEN [Sub-Category] END)}) + &quot; nhóm hàng bị lỗ&quot;' />
      </column>
      <column caption='Lỗ Lãi (kỳ)' datatype='string' name='[Calculation_3607415515963415]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3607415050858498] &lt; 0 THEN &quot;Lỗ&quot; ELSE &quot;Lãi&quot; END' />
      </column>
