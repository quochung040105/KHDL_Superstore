              <calculation class='tableau' formula='&quot;2019&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1uwefz30ha1kz11gx3cue1jap6an'>
            <column caption='Sales (kỳ)' datatype='real' name='[Calculation_3607415050133505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; THEN SUM([Sales]) ELSE SUM(IF STR(YEAR([Order Date])) = [Parameters].[Parameter 3607415047954432] THEN [Sales] END) END' />
            </column>
            <column caption='Sales kỳ trước' datatype='real' name='[Calculation_3607415051550729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] &lt;&gt; &quot;Tất cả&quot; THEN SUM(IF STR(YEAR([Order Date])) = STR(INT([Parameters].[Parameter 3607415047954432]) - 1) THEN [Sales] END) END' />
            </column>
            <column caption='Sales YoY %' datatype='real' default-format='p0.0%' name='[Calculation_3607415051624458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3607415050133505] - [Calculation_3607415051550729]) / [Calculation_3607415051550729]' />
            </column>
            <column caption='Title Sales' datatype='string' name='[Calculation_3607415052419092]' role='measure' type='nominal'>
              <calculation class='tableau' formula='&quot;Sales &quot; + IF [Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; THEN &quot;2016–2019&quot; ELSE [Parameters].[Parameter 3607415047954432] END + &quot;: &quot; + STR(INT(ROUND([Calculation_3607415050133505], 0))) + &quot; USD&quot; + IF ISNULL([Calculation_3607415051624458]) THEN &quot;, chưa có năm trước&quot; ELSE &quot;, &quot; + STR(ROUND([Calculation_3607415051624458] * 100, 1)) + &quot;% so với năm trước&quot; END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
