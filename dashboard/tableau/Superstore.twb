      <table>
        <view>
          <datasources>
            <datasource caption='fact_sales+' name='federated.1uwefz30ha1kz11gx3cue1jap6an' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Năm' datatype='string' name='[Parameter 3607415047954432]' param-domain-type='list' role='measure' type='nominal' value='&quot;2019&quot;'>
              <calculation class='tableau' formula='&quot;2019&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1uwefz30ha1kz11gx3cue1jap6an'>
            <column caption='Sales (kỳ)' datatype='real' name='[Calculation_3607415050133505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; THEN SUM([Sales]) ELSE SUM(IF STR(YEAR([Order Date])) = [Parameters].[Parameter 3607415047954432] THEN [Sales] END) END' />
            </column>
            <column caption='Profit (kỳ)' datatype='real' name='[Calculation_3607415050858498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; THEN SUM([Profit]) ELSE SUM(IF STR(YEAR([Order Date])) = [Parameters].[Parameter 3607415047954432] THEN [Profit] END) END' />
            </column>
            <column caption='Orders (kỳ)' datatype='integer' name='[Calculation_3607415050956803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; THEN COUNTD([Order ID]) ELSE COUNTD(IF STR(YEAR([Order Date])) = [Parameters].[Parameter 3607415047954432] THEN [Order ID] END) END' />
            </column>
            <column caption='Profit Margin %' datatype='real' default-format='p0.0%' name='[Calculation_3607415051145220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3607415050858498] / [Calculation_3607415050133505]' />
            </column>
            <column caption='Returned Orders (kỳ)' datatype='integer' name='[Calculation_3607415051309062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_returned] = 1 AND ([Parameters].[Parameter 3607415047954432] = &quot;Tất cả&quot; OR STR(YEAR([Order Date])) = [Parameters].[Parameter 3607415047954432]) THEN [Order ID] END)' />
